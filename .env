# 从 DeepSeek 开放平台获取密钥后，复制本文件为 .env 并填入。
# .env 已被 .gitignore 忽略，不要把真实密钥提交或写入前端代码。
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# 推荐精排使用高质量模型，需求解析使用速度更快的模型。
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_ANALYSIS_MODEL=deepseek-flash

# 高德开放平台「Web 服务」Key（POI 搜索、路径规划、地理编码）。
# 把你申请的 Web 服务 Key 填在等号后面，不要加引号。
AMAP_WEB_KEY=7552b49b06c71b77abfa4907d1b160ce

# 百度地图开放平台「服务端」AK（第二信息源，用于和高德双源对比核验）。
# 申请地址：https://lbsyun.baidu.com/ ，应用类型选「服务端」。
BAIDU_MAP_AK=Equ3wRD1oTmWwND3YbbI3GLT5PUm41XA

# 天地图（国家测绘局）浏览器端 Key，用于地形晕渲与官方影像底图。
# 申请地址：https://lbs.tianditu.gov.cn/
TIANDITU_KEY=855e614e1d328f4575e411bfb63656b5

# 和风天气 API KEY（实时天气、逐时预报、空气质量、生活指数）。
# 申请地址：https://dev.qweather.com/ ，控制台→项目管理→凭据管理创建 API KEY。
QWEATHER_KEY=5723d6a7b6cd4d88b7904937274b5e4d

# Supabase 后端存储（PostgreSQL + PostGIS，用户数据与第三方结果缓存）。
# Project URL 和 anon public key 在 Dashboard → Settings → API 获取。
SUPABASE_URL=https://juodjwzdzeibvnuotwet.supabase.co
SUPABASE_ANON_KEY=sb_publishable_EEwnGWpvEMMq5sYjIEFKaA_el9uLYds

# 可选：本地服务端口。
PORT=3001
