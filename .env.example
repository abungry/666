# 从 DeepSeek 开放平台获取密钥后，复制本文件为 .env 并填入。
# .env 已被 .gitignore 忽略，不要把真实密钥提交或写入前端代码。
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# 高德开放平台「Web 服务」Key（用于 POI 搜索、路径规划、地理编码）。
# 注意：这是 Web 服务 Key，必须放在后端，绝不能写入前端代码。
AMAP_WEB_KEY=your_amap_web_service_key_here

# 推荐精排使用高质量模型，需求解析使用速度更快的模型。
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_ANALYSIS_MODEL=deepseek-flash

# 可选：本地服务端口。
PORT=3000
