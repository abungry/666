# 复制本文件为 .env 并填入真实值。
# .env 已被 .gitignore 忽略，任何情况下都不要提交，也不要把密钥写进前端代码。

# ---- DeepSeek（AI 推荐与对话）----
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_ANALYSIS_MODEL=deepseek-chat

# ---- 高德开放平台「Web 服务」Key（POI 搜索 / 路径规划 / 地理编码）----
# 必须是 Web 服务 Key，只能放后端
AMAP_WEB_KEY=your_amap_web_service_key_here

# ---- 百度地图 AK（可选，用于对比检索）----
BAIDU_MAP_AK=your_baidu_ak_here

# ---- 天地图 Key（地形 / 影像底图）----
TIANDITU_KEY=your_tianditu_key_here

# ---- 和风天气 Key（必须使用项目专属 API 域名）----
QWEATHER_KEY=your_qweather_key_here

# ---- Supabase（访客数据存储；anon key 可公开，仅受 RLS 保护）----
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# ---- 服务端口 ----
PORT=3001
